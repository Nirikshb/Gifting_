# Server listen port (use a different port than the Next.js dev server, e.g. 3001)
PORT=3001

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=gift_packaging

# Google sign-in (optional — app starts without these)
# When GOOGLE_CLIENT_ID is set, SESSION_SECRET and FRONTEND_ORIGIN are required at startup.
# FRONTEND_ORIGIN must match the browser Origin exactly (scheme, host, port; no trailing slash).
# Used for credentialed CORS and CSRF origin checks on auth POST routes.
# GOOGLE_CLIENT_ID=
# SESSION_SECRET=
# FRONTEND_ORIGIN=http://localhost:3000

# Session lifetime in days (default 7 when sign-in is implemented)
# SESSION_TTL_DAYS=7

# Cookie SameSite for gp_session: lax, strict, or none (default lax; use none for cross-site API in Step 7)
# SESSION_COOKIE_SAME_SITE=lax

# Studio product management
# Stock at or below this number is reported as "low stock" in the admin area (default 5).
# LOW_STOCK_THRESHOLD=5
# Where uploaded product images are written (default: ./uploads/products inside the backend folder).
# PRODUCT_IMAGE_UPLOAD_DIR=
# Largest accepted product image in bytes (default 5 MB).
# PRODUCT_IMAGE_MAX_BYTES=5242880

# Transactional email (optional — the app starts and runs without any of these)
# Order emails are written to the `email_outbox` table inside the order
# transaction and are only delivered afterwards, so a missing provider never
# affects checkout. With no provider configured every row stays "pending" and
# records why; nothing is ever reported as delivered.
#
# Provider adapter. Only "none" (the default) and "sender" exist today; any
# other value stops the app at startup instead of silently never sending.
# EMAIL_PROVIDER=none
# EMAIL_PROVIDER=sender
# Sender identity (both are required before anything can be sent).
# EMAIL_FROM_NAME=Aapulki
# EMAIL_FROM_ADDRESS=
# Sender.net API token used by the transactional email provider (backend-only).
# Required at startup when EMAIL_PROVIDER=sender; never expose it to the browser
# and never store it in database settings.
# SENDER_API_TOKEN=
# Recipient for the "new order" studio email. Falls back to the first address
# in ADMIN_EMAILS when unset.
# ADMIN_NOTIFICATION_EMAIL=
# Delivery attempts before a row is marked failed (default 5).
# EMAIL_MAX_ATTEMPTS=5
# How often pending rows are swept for delivery, in ms (default 60000; 0 disables the sweep).
# EMAIL_DISPATCH_INTERVAL_MS=60000
#
# Absolute links inside emails use FRONTEND_ORIGIN (already required for
# Google sign-in), falling back to SITE_URL. If neither is set the emails are
# still sent, they just carry no links.
