# Server listen port (use a different port than the Next.js dev server, e.g. 3001)
PORT=3001

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=gift_packaging

# Google sign-in (optional — app starts without these)
# When GOOGLE_CLIENT_ID is set, SESSION_SECRET and FRONTEND_ORIGIN are required at startup.
# GOOGLE_CLIENT_ID=
# SESSION_SECRET=
# FRONTEND_ORIGIN=http://localhost:3000

# Session lifetime in days (default 7 when sign-in is implemented)
# SESSION_TTL_DAYS=7

# Cookie SameSite for gp_session: lax, strict, or none (default lax; use none for cross-site API in Step 7)
# SESSION_COOKIE_SAME_SITE=lax
