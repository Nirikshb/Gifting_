# Backend API origin (no trailing slash). Server-only. Use the backend PORT from backend/.env.example.
API_URL=http://localhost:3001

# Public site origin. Server-only. Required before production launch.
# Set this to the purchased origin, with https or http, no path, no query, and no trailing slash.
# Do not set this to localhost. Local development works while SITE_URL is unset.
# Canonical URLs, sitemap URLs, and the robots sitemap line are omitted until SITE_URL is a valid non-local origin.
# SITE_URL=

# Google Identity Services (optional — leave unset until you have a Web OAuth client ID)
# Must match backend GOOGLE_CLIENT_ID when sign-in is enabled.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Public analytics ids. Leave unset until you create the properties. Do not invent values.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# NEXT_PUBLIC_CLARITY_PROJECT_ID=
# ISO 4217 code. Commerce events do not send until this is set.
# NEXT_PUBLIC_GA_CURRENCY=
